using System.Net.Http;
using System.Text.Json;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.EntityFrameworkCore;
using FootyData.Models;

namespace FootyData.Data
{
    public interface IDataRepository
    {
        Task<List<(int Id, string Name)>> GetCompetitionsAsync();
        Task<List<(int Id, string Name)>> GetTeamsAsync(int competitionId);
        Task<List<MatchSummary>> GetMatchesAsync(int teamId, int competitionId);
        Task SyncAllDataAsync();
    }

    public class DataRepository : IDataRepository
    {
        private readonly HttpClient _httpClient;
        private readonly string _baseUrl;
        private readonly FootyDbContext _dbContext;
        private static readonly JsonSerializerOptions JsonOptions = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        public DataRepository(HttpClient httpClient, string baseUrl, FootyDbContext dbContext)
        {
            _httpClient = httpClient;
            _baseUrl = baseUrl.TrimEnd('/');
            _dbContext = dbContext;
        }

        public async Task<List<(int Id, string Name)>> GetCompetitionsAsync()
        {
            try
            {
                // Try to fetch from API first
                var apiUrl = $"{_baseUrl}/api/competitions";
                var response = await _httpClient.GetAsync(apiUrl).ConfigureAwait(false);

                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                    var competitions = JsonSerializer.Deserialize<List<CompetitionDto>>(json, JsonOptions);

                    if (competitions != null && competitions.Any())
                    {
                        // Cache in database
                        foreach (var comp in competitions)
                        {
                            var existing = await _dbContext.Competitions.FindAsync(comp.Id).ConfigureAwait(false);
                            if (existing == null)
                            {
                                _dbContext.Competitions.Add(new Competition { Id = comp.Id, Name = comp.Name });
                            }
                            else
                            {
                                existing.Name = comp.Name;
                            }
                        }
                        await _dbContext.SaveChangesAsync().ConfigureAwait(false);

                        return competitions.Select(c => (c.Id, c.Name ?? string.Empty)).ToList();
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error fetching competitions from API: {ex.Message}");
                // Fall back to database or hardcoded defaults
            }

            // Try to get from local database
            var cached = await _dbContext.Competitions.ToListAsync().ConfigureAwait(false);
            if (cached.Any())
            {
                return cached.Select(c => (c.Id, c.Name ?? string.Empty)).ToList();
            }

            // Fallback to hardcoded competitions if database is empty
            var defaults = new List<(int, string)>
            {
                (2021, "Premier League"),
                (2001, "Champions League")
            };

            // Seed the database with defaults
            foreach (var (id, name) in defaults)
            {
                _dbContext.Competitions.Add(new Competition { Id = id, Name = name });
            }
            await _dbContext.SaveChangesAsync().ConfigureAwait(false);

            return defaults;
        }

        public async Task<List<(int Id, string Name)>> GetTeamsAsync(int competitionId)
        {
            try
            {
                // Try to fetch from API first
                var apiUrl = $"{_baseUrl}/api/competitions/{competitionId}/teams";
                var response = await _httpClient.GetAsync(apiUrl).ConfigureAwait(false);

                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                    var teams = JsonSerializer.Deserialize<List<TeamSummary>>(json, JsonOptions);

                    if (teams != null)
                    {
                        // Cache in database
                        foreach (var team in teams)
                        {
                            var existing = await _dbContext.Teams.FindAsync(team.Id).ConfigureAwait(false);
                            if (existing == null)
                            {
                                _dbContext.Teams.Add(new Team { Id = team.Id, Name = team.Name, CompetitionId = competitionId });
                            }
                            else
                            {
                                existing.Name = team.Name;
                                existing.CompetitionId = competitionId;
                            }
                        }
                        await _dbContext.SaveChangesAsync().ConfigureAwait(false);

                        return teams.Select(t => (t.Id, t.Name ?? string.Empty)).ToList();
                    }
                }
            }
            catch
            {
                // Fall back to database
            }

            // Get from local database
            var cached = await _dbContext.Teams
                .Where(t => t.CompetitionId == competitionId)
                .ToListAsync()
                .ConfigureAwait(false);
            return cached.Select(t => (t.Id, t.Name ?? string.Empty)).ToList();
        }

        public async Task<List<MatchSummary>> GetMatchesAsync(int teamId, int competitionId)
        {
            try
            {
                // Try to fetch from API first
                var apiUrl = $"{_baseUrl}/api/fixtures/team/{teamId}?competitionId={competitionId}&limit=1000";
                var response = await _httpClient.GetAsync(apiUrl).ConfigureAwait(false);

                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                    var matches = JsonSerializer.Deserialize<List<MatchSummary>>(json, JsonOptions);

                    if (matches != null)
                    {
                        // Cache in database
                        foreach (var match in matches)
                        {
                            var existing = await _dbContext.Matches.FindAsync(match.Id).ConfigureAwait(false);
                            if (existing == null)
                            {
                                _dbContext.Matches.Add(new Match
                                {
                                    Id = match.Id,
                                    UtcDate = match.UtcDate,
                                    Status = match.Status,
                                    HomeTeamId = match.HomeTeam?.Id,
                                    AwayTeamId = match.AwayTeam?.Id,
                                    HomeScore = match.Score?.Home,
                                    AwayScore = match.Score?.Away,
                                    CompetitionId = competitionId
                                });
                            }
                            else
                            {
                                existing.Status = match.Status;
                                existing.HomeScore = match.Score?.Home;
                                existing.AwayScore = match.Score?.Away;
                            }
                        }
                        await _dbContext.SaveChangesAsync().ConfigureAwait(false);

                        return matches;
                    }
                }
            }
            catch
            {
                // Fall back to database
            }

            // Get from local database and map back to API model
            var cached = await _dbContext.Matches
                .Include(m => m.HomeTeam)
                .Include(m => m.AwayTeam)
                .Where(m => m.CompetitionId == competitionId && (m.HomeTeamId == teamId || m.AwayTeamId == teamId))
                .ToListAsync()
                .ConfigureAwait(false);

            return cached.Select(m => new MatchSummary
            {
                Id = m.Id,
                UtcDate = m.UtcDate,
                Status = m.Status,
                HomeTeam = m.HomeTeam != null ? new TeamSummary { Id = m.HomeTeam.Id, Name = m.HomeTeam.Name } : null,
                AwayTeam = m.AwayTeam != null ? new TeamSummary { Id = m.AwayTeam.Id, Name = m.AwayTeam.Name } : null,
                Score = new ScoreSummary { Home = m.HomeScore, Away = m.AwayScore }
            }).ToList();
        }

        public async Task SyncAllDataAsync()
        {
            // This can be called on app startup to ensure all data is synced
            try
            {
                var competitions = await GetCompetitionsAsync().ConfigureAwait(false);

                foreach (var (compId, _) in competitions)
                {
                    await GetTeamsAsync(compId).ConfigureAwait(false);

                    // Get all teams for this competition and fetch their matches
                    var teams = await _dbContext.Teams
                        .Where(t => t.CompetitionId == compId)
                        .ToListAsync()
                        .ConfigureAwait(false);

                    foreach (var team in teams)
                    {
                        await GetMatchesAsync(team.Id, compId).ConfigureAwait(false);
                    }
                }
            }
            catch
            {
                // Sync failure is not critical - local data is still available
            }
        }
    }

    // API DTOs
    public class CompetitionDto
    {
        public int Id { get; set; }
        public string? Name { get; set; }
    }
}
