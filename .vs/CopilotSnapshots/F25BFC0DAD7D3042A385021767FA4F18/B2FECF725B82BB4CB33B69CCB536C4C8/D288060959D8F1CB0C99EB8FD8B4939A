using System.Net.Http;
using System.Text.Json;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.EntityFrameworkCore;
using FootyData.Models;
using System;

namespace FootyData.Data
{
    public interface IDataRepository
    {
        Task<List<(int Id, string Name)>> GetCompetitionsAsync();
        Task<List<(int Id, string Name)>> GetTeamsAsync(int competitionId);
        Task<List<MatchSummary>> GetMatchesAsync(int teamId, int competitionId);
        Task SyncAllDataAsync();
    }

    public class DataRepository : IDataRepository
    {
        private readonly HttpClient _httpClient;
        private readonly string _baseUrl;
        private readonly FootyDbContext _dbContext;
        private static readonly JsonSerializerOptions JsonOptions = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        // Rate limiting
        private DateTime _lastRequestTime = DateTime.MinValue;
        private readonly int _minDelayMs = 500; // Minimum delay between requests (500ms)

        public DataRepository(HttpClient httpClient, string baseUrl, FootyDbContext dbContext)
        {
            _httpClient = httpClient;
            _baseUrl = baseUrl.TrimEnd('/');
            _dbContext = dbContext;
        }

        // Helper method to make HTTP requests with rate limit handling
        private async Task<HttpResponseMessage> GetWithRateLimitAsync(string url, int retryCount = 0)
        {
            // Enforce minimum delay between requests
            var timeSinceLastRequest = DateTime.UtcNow - _lastRequestTime;
            if (timeSinceLastRequest.TotalMilliseconds < _minDelayMs)
            {
                var delayNeeded = _minDelayMs - (int)timeSinceLastRequest.TotalMilliseconds;
                System.Diagnostics.Debug.WriteLine($"Rate limit delay: {delayNeeded}ms");
                await Task.Delay(delayNeeded).ConfigureAwait(false);
            }

            _lastRequestTime = DateTime.UtcNow;

            try
            {
                var response = await _httpClient.GetAsync(url).ConfigureAwait(false);

                // Handle 429 (Too Many Requests) with exponential backoff
                if ((int)response.StatusCode == 429)
                {
                    if (retryCount < 3)
                    {
                        var delayMs = (int)Math.Pow(2, retryCount) * 1000; // 1s, 2s, 4s
                        System.Diagnostics.Debug.WriteLine($"Got 429, retry {retryCount + 1}/3 after {delayMs}ms");
                        await Task.Delay(delayMs).ConfigureAwait(false);
                        return await GetWithRateLimitAsync(url, retryCount + 1);
                    }
                }

                return response;
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"GetWithRateLimitAsync error: {ex.Message}");
                throw;
            }
        }

        /// <summary>
        /// Gets cached competitions from database (no API call).
        /// Used for background sync when UI has already loaded competitions.
        /// </summary>
        public async Task<List<(int Id, string Name)>> GetCachedCompetitionsAsync()
        {
            try
            {
                var cached = await _dbContext.Competitions.ToListAsync().ConfigureAwait(false);
                System.Diagnostics.Debug.WriteLine($"GetCachedCompetitionsAsync: Got {cached.Count} competitions from cache");
                return cached.Select(c => (c.Id, c.Name ?? string.Empty)).ToList();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"GetCachedCompetitionsAsync ERROR: {ex.Message}");
                return new List<(int, string)>();
            }
        }

        /// <summary>
        /// Gets teams for a competition from database only (no API call).
        /// </summary>
        public async Task<List<(int Id, string Name)>> GetTeamsFromDbAsync(int competitionId)
        {
            try
            {
                var teams = await _dbContext.Teams
                    .Where(t => t.CompetitionId == competitionId)
                    .ToListAsync()
                    .ConfigureAwait(false);
                System.Diagnostics.Debug.WriteLine($"GetTeamsFromDbAsync({competitionId}): Got {teams.Count} teams from DB");
                return teams.Select(t => (t.Id, t.Name ?? string.Empty)).ToList();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"GetTeamsFromDbAsync ERROR: {ex.Message}");
                return new List<(int, string)>();
            }
        }

        /// <summary>
        /// Gets matches for a team/competition from database only (no API call).
        /// </summary>
        public async Task<List<MatchSummary>> GetMatchesFromDbAsync(int teamId, int competitionId)
        {
            try
            {
                var matches = await _dbContext.Matches
                    .Include(m => m.HomeTeam)
                    .Include(m => m.AwayTeam)
                    .Where(m => m.CompetitionId == competitionId && (m.HomeTeamId == teamId || m.AwayTeamId == teamId))
                    .ToListAsync()
                    .ConfigureAwait(false);

                System.Diagnostics.Debug.WriteLine($"GetMatchesFromDbAsync({teamId}, {competitionId}): Got {matches.Count} matches from DB");

                return matches.Select(m => new MatchSummary
                {
                    Id = m.Id,
                    UtcDate = m.UtcDate,
                    Status = m.Status,
                    HomeTeam = m.HomeTeam != null ? new TeamSummary { Id = m.HomeTeam.Id, Name = m.HomeTeam.Name } : null,
                    AwayTeam = m.AwayTeam != null ? new TeamSummary { Id = m.AwayTeam.Id, Name = m.AwayTeam.Name } : null,
                    Score = new ScoreSummary { Home = m.HomeScore, Away = m.AwayScore }
                }).ToList();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"GetMatchesFromDbAsync ERROR: {ex.Message}");
                return new List<MatchSummary>();
            }
        }

        public async Task<List<(int Id, string Name)>> GetCompetitionsAsync()
        {
            try
            {
                // Try to fetch from API first
                var apiUrl = $"{_baseUrl}/api/competitions";
                var response = await GetWithRateLimitAsync(apiUrl).ConfigureAwait(false);

                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                    var competitions = JsonSerializer.Deserialize<List<CompetitionDto>>(json, JsonOptions);

                    if (competitions != null && competitions.Any())
                    {
                        // Cache in database
                        foreach (var comp in competitions)
                        {
                            var existing = await _dbContext.Competitions.FindAsync(comp.Id).ConfigureAwait(false);
                            if (existing == null)
                            {
                                _dbContext.Competitions.Add(new Competition { Id = comp.Id, Name = comp.Name });
                            }
                            else
                            {
                                existing.Name = comp.Name;
                            }
                        }
                        await _dbContext.SaveChangesAsync().ConfigureAwait(false);

                        return competitions.Select(c => (c.Id, c.Name ?? string.Empty)).ToList();
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error fetching competitions from API: {ex.Message}");
                // Fall back to database or hardcoded defaults
            }

            // Try to get from local database
            var cached = await _dbContext.Competitions.ToListAsync().ConfigureAwait(false);
            if (cached.Any())
            {
                return cached.Select(c => (c.Id, c.Name ?? string.Empty)).ToList();
            }

            // Fallback to hardcoded competitions if database is empty
            var defaults = new List<(int, string)>
            {
                (2021, "Premier League"),
                (2001, "Champions League")
            };

            // Seed the database with defaults
            foreach (var (id, name) in defaults)
            {
                _dbContext.Competitions.Add(new Competition { Id = id, Name = name });
            }
            await _dbContext.SaveChangesAsync().ConfigureAwait(false);

            return defaults;
        }

        public async Task<List<(int Id, string Name)>> GetTeamsAsync(int competitionId)
        {
            try
            {
                // Try to fetch from API first
                var apiUrl = $"{_baseUrl}/api/competitions/{competitionId}/teams";
                var response = await GetWithRateLimitAsync(apiUrl).ConfigureAwait(false);

                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                    var teams = JsonSerializer.Deserialize<List<TeamSummary>>(json, JsonOptions);

                    if (teams != null && teams.Any())
                    {
                        // Cache in database
                        foreach (var team in teams)
                        {
                            var existing = await _dbContext.Teams.FindAsync(team.Id).ConfigureAwait(false);
                            if (existing == null)
                            {
                                _dbContext.Teams.Add(new Team { Id = team.Id, Name = team.Name, CompetitionId = competitionId });
                            }
                            else
                            {
                                existing.Name = team.Name;
                                existing.CompetitionId = competitionId;
                            }
                        }
                        await _dbContext.SaveChangesAsync().ConfigureAwait(false);

                        return teams.Select(t => (t.Id, t.Name ?? string.Empty)).ToList();
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error fetching teams for competition {competitionId}: {ex.Message}");
                // Fall back to database
            }

            // Get from local database
            var cached = await _dbContext.Teams
                .Where(t => t.CompetitionId == competitionId)
                .ToListAsync()
                .ConfigureAwait(false);

            if (cached.Any())
            {
                return cached.Select(t => (t.Id, t.Name ?? string.Empty)).ToList();
            }

            // Fallback to hardcoded teams if database is empty
            var defaults = competitionId switch
            {
                2021 => new List<(int, string)>
                {
                    (57, "Arsenal"),
                    (66, "Manchester United"),
                    (61, "Chelsea")
                },
                2001 => new List<(int, string)>
                {
                    (86, "Real Madrid"),
                    (5, "Bayern Munich"),
                    (81, "Barcelona")
                },
                _ => new List<(int, string)>()
            };

            // Seed the database with defaults
            foreach (var (id, name) in defaults)
            {
                _dbContext.Teams.Add(new Team { Id = id, Name = name, CompetitionId = competitionId });
            }
            await _dbContext.SaveChangesAsync().ConfigureAwait(false);

            return defaults;
        }

        public async Task<List<MatchSummary>> GetMatchesAsync(int teamId, int competitionId)
        {
            try
            {
                // Try to fetch from API first
                var apiUrl = $"{_baseUrl}/api/fixtures/team/{teamId}?competitionId={competitionId}&limit=1000";
                var response = await GetWithRateLimitAsync(apiUrl).ConfigureAwait(false);

                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                    var matches = JsonSerializer.Deserialize<List<MatchSummary>>(json, JsonOptions);

                    if (matches != null)
                    {
                        // Cache in database
                        foreach (var match in matches)
                        {
                            var existing = await _dbContext.Matches.FindAsync(match.Id).ConfigureAwait(false);
                            if (existing == null)
                            {
                                _dbContext.Matches.Add(new Match
                                {
                                    Id = match.Id,
                                    UtcDate = match.UtcDate,
                                    Status = match.Status,
                                    HomeTeamId = match.HomeTeam?.Id,
                                    AwayTeamId = match.AwayTeam?.Id,
                                    HomeScore = match.Score?.Home,
                                    AwayScore = match.Score?.Away,
                                    CompetitionId = competitionId
                                });
                            }
                            else
                            {
                                existing.Status = match.Status;
                                existing.HomeScore = match.Score?.Home;
                                existing.AwayScore = match.Score?.Away;
                            }
                        }
                        await _dbContext.SaveChangesAsync().ConfigureAwait(false);

                        return matches;
                    }
                }
            }
            catch
            {
                // Fall back to database
            }

            // Get from local database and map back to API model
            var cached = await _dbContext.Matches
                .Include(m => m.HomeTeam)
                .Include(m => m.AwayTeam)
                .Where(m => m.CompetitionId == competitionId && (m.HomeTeamId == teamId || m.AwayTeamId == teamId))
                .ToListAsync()
                .ConfigureAwait(false);

            return cached.Select(m => new MatchSummary
            {
                Id = m.Id,
                UtcDate = m.UtcDate,
                Status = m.Status,
                HomeTeam = m.HomeTeam != null ? new TeamSummary { Id = m.HomeTeam.Id, Name = m.HomeTeam.Name } : null,
                AwayTeam = m.AwayTeam != null ? new TeamSummary { Id = m.AwayTeam.Id, Name = m.AwayTeam.Name } : null,
                Score = new ScoreSummary { Home = m.HomeScore, Away = m.AwayScore }
            }).ToList();
        }

        public async Task BulkSyncAsync()
        {
            // Comprehensive one-time sync: loads competitions, teams, and matches for all teams
            // This is called once on startup. All subsequent operations use DB only.
            try
            {
                System.Diagnostics.Debug.WriteLine("BulkSyncAsync: Starting comprehensive data sync...");

                // Step 1: Load competitions
                System.Diagnostics.Debug.WriteLine("BulkSyncAsync: Step 1 - Loading competitions");
                var competitions = await GetCompetitionsAsync().ConfigureAwait(false);
                System.Diagnostics.Debug.WriteLine($"BulkSyncAsync: Loaded {competitions.Count} competitions");

                // Step 2: Load teams for each competition
                var allTeams = new List<(int Id, int CompetitionId, string Name)>();
                foreach (var (compId, compName) in competitions)
                {
                    try
                    {
                        System.Diagnostics.Debug.WriteLine($"BulkSyncAsync: Step 2 - Loading teams for {compName} ({compId})");
                        var teams = await GetTeamsAsync(compId).ConfigureAwait(false);
                        allTeams.AddRange(teams.Select(t => (t.Id, compId, t.Name)));
                        System.Diagnostics.Debug.WriteLine($"BulkSyncAsync: Loaded {teams.Count} teams for {compName}");
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine($"BulkSyncAsync: Failed to load teams for {compName}: {ex.Message}");
                    }
                }

                // Step 3: Load matches for all teams
                System.Diagnostics.Debug.WriteLine($"BulkSyncAsync: Step 3 - Loading matches for {allTeams.Count} teams");
                int matchesLoaded = 0;
                foreach (var (teamId, compId, teamName) in allTeams)
                {
                    try
                    {
                        var matches = await GetMatchesAsync(teamId, compId).ConfigureAwait(false);
                        matchesLoaded += matches.Count;
                        System.Diagnostics.Debug.WriteLine($"BulkSyncAsync: Loaded {matches.Count} matches for team {teamName}");
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine($"BulkSyncAsync: Failed to load matches for team {teamName}: {ex.Message}");
                    }
                }

                System.Diagnostics.Debug.WriteLine($"BulkSyncAsync: COMPLETE - {competitions.Count} competitions, {allTeams.Count} teams, {matchesLoaded} matches cached");
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"BulkSyncAsync ERROR: {ex}");
            }
        }

        public async Task SyncAllDataAsync()
        {
            // Legacy method for compatibility - now just calls BulkSyncAsync
            await BulkSyncAsync().ConfigureAwait(false);
        }
    }

    // API DTOs
    public class CompetitionDto
    {
        public int Id { get; set; }
        public string? Name { get; set; }
    }
}
